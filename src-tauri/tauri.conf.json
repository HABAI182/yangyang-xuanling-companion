{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "秧秧玄翎", "version": "0.1.1", "identifier": "local.habai182.yangyang-xuanling",
  "build": {"beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1437", "beforeBuildCommand": "npm run build", "frontendDist": "../dist"},
