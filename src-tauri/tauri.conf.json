  "bundle": {"active":true, "targets":["nsis"], "icon":["icons/icon.ico"], "shortDescription":"秧秧玄翎桌面伴侣制作预览", "windows":{"nsis":{"languages":["SimpChinese"],"displayLanguageSelector":false}}, "licenseFile":"../LICENSE.txt"}
